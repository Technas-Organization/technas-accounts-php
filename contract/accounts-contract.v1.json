{
  "version": 1,
  "about": "The Technas accounts API as every Technas SDK must speak it. The fake server of each SDK's tests answers from this file; the real gateway is tested against the same shapes.",
  "base_url": "https://pay-api.technas.fr",
  "user_id": "7d3f2a10-1111-4222-8333-444455556666",
  "routes": [
    {"name": "config", "method": "GET", "path": "/v1/accounts/config", "status": 200,
     "response": {"issuer": "https://auth.technas.fr/realms/app-demo", "client_id": "demo-app",
                  "discovery_url": "https://auth.technas.fr/realms/app-demo/.well-known/openid-configuration",
                  "authorization_endpoint": "https://auth.technas.fr/realms/app-demo/protocol/openid-connect/auth",
                  "token_endpoint": "https://auth.technas.fr/realms/app-demo/protocol/openid-connect/token",
                  "jwks_uri": "https://auth.technas.fr/realms/app-demo/protocol/openid-connect/certs",
                  "end_session_endpoint": "https://auth.technas.fr/realms/app-demo/protocol/openid-connect/logout",
                  "pkce": "S256", "methods": ["email", "whatsapp"], "redirect_uris": ["https://demo.example/*"]}},
    {"name": "tokens.verify", "method": "POST", "path": "/v1/accounts/tokens/verify", "status": 200,
     "request": {"token": "eyJhbGciOiJSUzI1NiJ9.demo.signature"},
     "response": {"valid": true, "user_id": "7d3f2a10-1111-4222-8333-444455556666", "client_id": "demo-app",
                  "email": null, "email_verified": false, "phone": "+22890000002", "phone_verified": true,
                  "roles": ["admin"], "expires_at": 1900000000}},
    {"name": "users.resolve", "method": "POST", "path": "/v1/accounts/users/resolve", "status": 200,
     "request": {"proof": "verified", "phone": "+22890000002"},
     "response": {"id": "7d3f2a10-1111-4222-8333-444455556666", "created": true, "phone": "+22890000002",
                  "phone_verified": true, "email": null, "email_verified": false}},
    {"name": "users.list", "method": "GET", "path": "/v1/accounts/users", "status": 200,
     "query": {"page": "0", "page_size": "10", "search": "awa"},
     "response": {"total": 1, "page": 0, "page_size": 10, "users": [
       {"id": "7d3f2a10-1111-4222-8333-444455556666", "name": "Awa Mensah", "email": null, "email_verified": false,
        "phone": "+22890000002", "phone_verified": true, "enabled": true, "created_at": "2026-11-16T14:29:00Z", "methods": ["whatsapp"]}]}},
    {"name": "users.get", "method": "GET", "path": "/v1/accounts/users/7d3f2a10-1111-4222-8333-444455556666", "status": 200,
     "response": {"id": "7d3f2a10-1111-4222-8333-444455556666", "name": "Awa Mensah", "email": null, "email_verified": false,
                  "phone": "+22890000002", "phone_verified": true, "enabled": true, "created_at": "2026-11-16T14:29:00Z",
                  "methods": ["whatsapp"], "roles": ["admin"], "open_sessions": 1, "last_activity_at": null, "last_sign_in_at": null}},
    {"name": "users.set_roles", "method": "PUT", "path": "/v1/accounts/users/7d3f2a10-1111-4222-8333-444455556666/roles", "status": 200,
     "request": {"roles": ["admin"]}, "response": {"id": "7d3f2a10-1111-4222-8333-444455556666", "roles": ["admin"]}},
    {"name": "users.disable", "method": "PUT", "path": "/v1/accounts/users/7d3f2a10-1111-4222-8333-444455556666/status", "status": 200,
     "request": {"enabled": false}, "response": {"id": "7d3f2a10-1111-4222-8333-444455556666", "enabled": false}},
    {"name": "users.revoke_sessions", "method": "POST", "path": "/v1/accounts/users/7d3f2a10-1111-4222-8333-444455556666/sessions/revoke", "status": 200,
     "response": {"id": "7d3f2a10-1111-4222-8333-444455556666", "revoked": 2}},
    {"name": "roles.list", "method": "GET", "path": "/v1/accounts/roles", "status": 200, "response": {"roles": ["admin", "staff"]}},
    {"name": "roles.declare", "method": "PUT", "path": "/v1/accounts/roles", "status": 200,
     "request": {"roles": ["staff"]}, "response": {"roles": ["admin", "staff"]}}
  ],
  "errors": [
    {"status": 401, "body": {"code": "invalid_api_key", "message": "Invalid API key"}, "retryable": false},
    {"status": 404, "body": {"code": "accounts_not_enabled", "message": "User sign-in is not enabled for this environment. Enable it in the console (Users)."}, "retryable": false},
    {"status": 404, "body": {"code": "user_not_found", "message": "No such user in this application"}, "retryable": false},
    {"status": 422, "body": {"code": "unknown_role", "message": "Declare the role first (PUT /v1/accounts/roles)"}, "retryable": false},
    {"status": 429, "body": {"code": "rate_limited", "message": "Too many requests"}, "retryable": true},
    {"status": 503, "body": {"code": "unavailable", "message": "Service temporarily unavailable"}, "retryable": true}
  ]
}
